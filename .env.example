# Copy this file to .env and fill in real values. .env is never committed.
#
# The agent model is the brain: one model per agent, chosen at birth and kept
# for life. The memory model folds each finished round into MEMORY and may be a
# cheaper one. Both are OpenAI-compatible chat endpoints.

AGENT_MODEL_BASE_URL=https://api.example.com/v1
AGENT_MODEL_API_KEY=replace-me
AGENT_MODEL_NAME=replace-me

MEMORY_MODEL_BASE_URL=https://api.example.com/v1
MEMORY_MODEL_API_KEY=replace-me
MEMORY_MODEL_NAME=replace-me
