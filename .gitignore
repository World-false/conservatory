# Runtime directories. These are anchored to the repository root on purpose:
# an unanchored "SUPERVISOR/" also matches src/supervisor/ on a case-insensitive
# filesystem, which would silently keep the supervisor's source out of git.
/node_modules/
/dist/
/.env
*.env
/AGENTS/
/SUPERVISOR/
# The model roster carries provider API keys, exactly like .env does, so it is
# never committed. conservatory.config.json holds no secrets and stays tracked.
/conservatory.models.json
